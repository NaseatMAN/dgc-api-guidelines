{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Queue": {
    "DefaultTransport": "InMemory",
    "Retry": {
      "Limit": 10,
      "DelayMs": 100
    },
    "DeadLetter": {
      "Enabled": true,
      "Prefix": "deadletter"
    },
    "MaxPayloadBytes": 262144
  },
  "WorkerQueueSettings": {
    "BackgroundOrderCreated": {
      "PollIntervalSeconds": 1,
      "MaxDegreeOfParallelism": 1
    },
    "BackgroundOrderCreatedRedis": {
      "PollIntervalSeconds": 1,
      "MaxDegreeOfParallelism": 1
    }
  }
}
